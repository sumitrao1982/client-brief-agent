# --- LLM: Claude (Anthropic API) used by the Google ADK agents ---
# Get a key at https://console.anthropic.com/ (Settings -> API keys)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model for the coordinator and brief writer
CLAUDE_MODEL=claude-opus-5-5
# Optional: cheaper model for the three research specialists, e.g. claude-sonnet-5-5 or claude-haiku-5-5
# CLAUDE_SPECIALIST_MODEL=claude-sonnet-5-5
# Reasoning effort: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# --- CORS (comma separated) ---
FRONTEND_ORIGINS=http://localhost:5173
